#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["rich"]
# ///
"""Start, stop, check on, log in to, and run commands on my Coder workspaces.

Commands act on all workspaces except those matching an entry in the `exclude`
list of codo.toml (in the directory above this script), unless they're given
workspaces by name: `login <workspace>`, `forward`, `tunnel`, and `-w` for
start, stop and restart.
"""

import argparse
import base64
import concurrent.futures
import dataclasses as dc
import fnmatch
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
from datetime import datetime
from datetime import timedelta
from datetime import timezone
from pathlib import Path
from typing import NamedTuple, TextIO

from rich.console import Console
from rich.live import Live
from rich.markup import escape
from rich.spinner import Spinner
from rich.table import Table
from rich.text import Text

CONFIG_PATH = Path(__file__).resolve().parent.parent / "codo.toml"

# A build in one of these states didn't reach its target, so it's worth retrying.
RETRY_STATUSES = {"failed", "canceled"}

# coder prints "==> ⧗ <stage>" when a build or agent stage begins, and
# "=== ✔ <stage> [123ms]" (✘ if it failed) when it ends.
STAGE_START = re.compile(r"^==> ⧗ (?P<stage>.+)$")
STAGE_END = re.compile(r"^=== (?P<mark>[✔✘]) (?P<stage>.+) \[\d+ms\]$")
ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")

# Advanced one frame per chunk of new output, so it only moves on activity.
SPINNER_FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
# How much of a failed command's output to print; its log file has all of it.
OUTPUT_LINES = 30
DONE = {"start": "ready", "stop": "stopped"}
ICONS = {"ok": "[green]✓", "warning": "[yellow]⚠", "failed": "[red]✗"}
STYLES = {"running": "", "ok": "green", "warning": "yellow", "failed": "red"}

# `codo status` re-polls this often while any workspace is changing state.
POLL_SECONDS = 2
BUSY_BUILDS = {"pending", "starting", "stopping", "canceling", "deleting"}
AGENT_PROBLEMS = {
    "start_error": "startup script failed",
    "start_timeout": "startup script timed out",
}
STATUS_ICONS = {
    "ok": "[green]●",
    "stopped": "[dim]○",
    "warning": "[yellow]●",
    "failed": "[red]✗",
}
STATUS_STYLES = {
    "ok": "green",
    "stopped": "dim",
    "warning": "yellow",
    "failed": "red",
    "busy": "cyan",
}

# What `gcloud auth login --no-browser` prints on the workspace. The first
# yes/no prompt is its "You are running on a GCE VM, continue?" check.
YES_NO_PROMPT = "(Y/n)?"
AUTH_PROMPT = "Enter the output of the above command:"
REMOTE_BOOTSTRAP = re.compile(r'--remote-bootstrap="(?P<url>[^"]+)"')
# Printed once the token exchange succeeds. With --update-adc, gcloud writes
# ADC too (failing the command if it can't), but only mentions it when the
# file's contents changed, so success doesn't depend on that message.
LOGGED_IN = re.compile(r"You are now logged in as \[(?P<account>[^\]]+)\]")
# The line `gcloud auth login --remote-bootstrap` prints locally, to paste back.
AUTH_RESPONSE = re.compile(r"^https?://\S+[?&]code=\S+$", re.MULTILINE)
STAGE_LINE = re.compile(STAGE_START.pattern, re.MULTILINE)

# Where `codo fetch` and `codo clyde` run, unless codo.toml lists `repos`.
DEFAULT_REPO = "/home/discord/dev/discord/discord"
# coder's own report of a nonzero exit, which the table already shows.
CODER_EXIT_NOISE = re.compile(
    r'^(Encountered an error running "coder ssh".*'
    r"|error: run command: Process exited with status \d+)$"
)

# Copying application default credentials (ADC) between workspaces. These run
# under sh on the workspace; see remote_sh() for why they avoid backslashes.
ADC_FILE = (
    "${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json"
)
# set -e so a missing file reports base64's error rather than an empty line.
READ_ADC = f'set -e; adc=$(base64 -w0 "{ADC_FILE}"); echo "CODO_ADC:$adc"'
ADC_LINE = re.compile(r"CODO_ADC:(?P<adc>[A-Za-z0-9+/=]+)")
# Reads the file from $CODO_ADC (base64) and replaces it atomically, mode 600.
WRITE_ADC = "; ".join(
    [
        "set -e",
        f'f="{ADC_FILE}"',
        'mkdir -p "$(dirname "$f")"',
        "umask 077",
        'printf %s "$CODO_ADC" | base64 -d > "$f.codo-tmp"',
        'mv "$f.codo-tmp" "$f"',
        "echo CODO_OK",
    ]
)

# `codo forward` keeps track of its background `clyde coder forward` here.
FORWARD_DIR = (
    Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "codo"
)
FORWARD_STATE = FORWARD_DIR / "forward.json"
FORWARD_LOG = FORWARD_DIR / "forward.log"
# What coder port-forward prints once it's listening on every port.
FORWARD_READY = re.compile(r"^Ready!$", re.MULTILINE)
# coder port-forward prints one of these per port as it starts listening.
FORWARD_PORT = re.compile(r"^Forwarding '", re.MULTILINE)
# Starting the workspace first can take a few minutes.
FORWARD_READY_SECONDS = 300
FORWARD_STOP_SECONDS = 10

console = Console()


def load_config(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


def is_excluded(name: str, excludes: list[str]) -> bool:
    return any(fnmatch.fnmatchcase(name, pattern) for pattern in excludes)


def list_workspaces() -> list[dict]:
    # Leave stderr attached so errors like "not logged in" reach the terminal.
    proc = subprocess.run(
        ["coder", "list", "--output", "json"], stdout=subprocess.PIPE, text=True
    )
    if proc.returncode != 0:
        sys.exit(proc.returncode)
    return json.loads(proc.stdout)


def needs_action(workspace: dict, action: str) -> bool:
    """Whether `action` (start/stop) would change this workspace.

    The build transition is "start", "stop" or "delete", so a workspace whose
    latest build already has the requested transition is there (or getting
    there) unless that build failed.
    """
    build = workspace["latest_build"]
    if build["transition"] == "delete":
        return False
    return build["transition"] != action or build["status"] in RETRY_STATUSES


def steps(action: str, name: str) -> list[tuple[str, list[str]]]:
    """The (label, command) pairs to run for one workspace."""
    # --yes keeps coder from blocking on confirmation prompts.
    if action == "stop":
        return [("Stopping", ["coder", "stop", "--yes", name])]
    return [
        ("Starting", ["coder", "start", "--yes", name]),
        # coder start returns once the build is done, while the agent's startup
        # scripts (personalize, dotfiles) are still running. This waits for them.
        ("Waiting for agent", ["coder", "ssh", "--wait=yes", name, "true"]),
    ]


@dc.dataclass
class Job:
    """One workspace's run through its coder commands, updated as output arrives."""

    name: str
    steps: list[tuple[str, list[str]]]
    done: str
    phase: str = "Queued"
    returncode: int | None = None
    failed_stages: list[str] = dc.field(default_factory=list)
    output: list[str] = dc.field(default_factory=list)
    began: float = dc.field(default_factory=time.monotonic)
    ended: float | None = None
    log: Path | None = None  # Where run() saves the full output.
    ticks: int = 0  # Chunks of output seen, which drive the spinner.

    @property
    def state(self) -> str:
        if self.ended is None:
            return "running"
        if self.returncode:
            return "failed"
        if self.failed_stages:
            return "warning"
        return "ok"

    @property
    def spinner(self) -> str:
        return SPINNER_FRAMES[self.ticks % len(SPINNER_FRAMES)]

    @property
    def elapsed(self) -> str:
        seconds = int((self.ended or time.monotonic()) - self.began)
        return f"{seconds // 60}:{seconds % 60:02d}"

    def run(self) -> None:
        self.began = time.monotonic()
        # Line-buffered, so the log can be followed (tail -f) while this runs.
        with open(self.log or os.devnull, "w", buffering=1) as log:
            for label, cmd in self.steps:
                self.phase = label
                log.write(f"### {label}\n")
                self.returncode = self._run(cmd, log)
                if self.returncode:
                    # Keep a coder stage name if one says where it failed;
                    # otherwise name the step, if there's more than one.
                    if self.phase == label:
                        step = f"{label} " if len(self.steps) > 1 else ""
                        self.phase = f"{step}failed (exit {self.returncode})"
                    break
        self.ended = time.monotonic()
        if self.state == "ok":
            self.phase = self.done
        elif self.state == "warning":
            self.phase = f"{self.failed_stages[0]} failed"

    def _run(self, cmd: list[str], log: TextIO) -> int:
        # Read bytes and split on \n only: text mode would also split on the
        # \r that progress meters (like git's) use to redraw a line, turning
        # each redraw into a line of output.
        with subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        ) as proc:
            assert proc.stdout is not None
            pending = b""
            while chunk := os.read(proc.stdout.fileno(), 65536):
                self.ticks += 1  # Any new output, even a redraw, moves the spinner.
                *lines, pending = (pending + chunk).split(b"\n")
                for line in lines:
                    self._feed(line.decode(errors="replace"), log)
            if pending:
                self._feed(pending.decode(errors="replace"), log)
        return proc.returncode

    def _feed(self, raw: str, log: TextIO) -> None:
        # Keep only what a terminal would show: no colors, last \r-overwrite wins.
        line = ANSI_ESCAPE.sub("", raw).rstrip().rsplit("\r", 1)[-1]
        log.write(line + "\n")
        if not line.strip():
            return
        self.output.append(line)
        if match := STAGE_START.match(line):
            self.phase = match["stage"]
        elif (match := STAGE_END.match(line)) and match["mark"] == "✘":
            self.failed_stages.append(match["stage"])


def render(jobs: list[Job]) -> Table:
    table = Table.grid(padding=(0, 1))
    table.add_column(width=1)
    table.add_column(no_wrap=True, style="bold")
    table.add_column(no_wrap=True)
    table.add_column(no_wrap=True, justify="right", style="dim")
    for job in jobs:
        state = job.state
        table.add_row(
            f"[cyan]{job.spinner}" if state == "running" else ICONS[state],
            job.name,
            Text(job.phase, style=STYLES[state]),
            job.elapsed,
        )
    return table


def summarize(workspace: dict) -> tuple[str, str]:
    """Describe a workspace as (kind, label), where kind is a STATUS_STYLES key."""
    build = workspace["latest_build"]
    status = build["status"]
    if status in BUSY_BUILDS:
        return "busy", status
    if status == "stopped":
        return "stopped", status
    if status != "running":
        return "failed", status
    for agent in agents(workspace):
        lifecycle = agent["lifecycle_state"]
        if agent["status"] == "connecting":
            return "busy", "waiting for agent"
        if agent["status"] != "connected":
            return "warning", f"agent {agent['status']}"
        if lifecycle in ("created", "starting"):
            return "busy", "running startup scripts"
        if lifecycle != "ready":
            label = lifecycle.replace("_", " ")
            return "warning", AGENT_PROBLEMS.get(lifecycle, f"agent {label}")
    if not workspace["health"]["healthy"]:
        return "warning", "unhealthy"
    return "ok", status


def agents(workspace: dict) -> list[dict]:
    resources = workspace["latest_build"]["resources"]
    return [agent for resource in resources for agent in resource.get("agents") or []]


def is_active(workspace: dict) -> bool:
    """Running with its agents connected, so `coder ssh` works right away."""
    statuses = [agent["status"] for agent in agents(workspace)]
    running = workspace["latest_build"]["status"] == "running"
    return running and bool(statuses) and all(s == "connected" for s in statuses)


def parse_time(value: str | None) -> datetime | None:
    # coder uses either null or the zero time (year 1) for "not set".
    if not value:
        return None
    when = datetime.fromisoformat(value)
    return when if when.year > 1 else None


def duration(delta: timedelta) -> str:
    minutes = int(delta.total_seconds()) // 60
    days, minutes = divmod(minutes, 24 * 60)
    hours, minutes = divmod(minutes, 60)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m" if minutes else "<1m"


def schedule(workspace: dict, now: datetime) -> str:
    """When the workspace will next auto-stop (if running) or auto-start."""
    status = workspace["latest_build"]["status"]
    if status == "running":
        verb, when = "stops", parse_time(workspace["latest_build"]["deadline"])
    elif status == "stopped":
        verb, when = "starts", parse_time(workspace["next_start_at"])
    else:
        return ""
    return f"{verb} in {duration(when - now)}" if when and when > now else ""


def render_status(
    workspaces: list[dict], tick: int, forwarded: str | None = None
) -> Table:
    now = datetime.now(timezone.utc)
    table = Table.grid(padding=(0, 2))
    for _ in range(4):
        table.add_column(no_wrap=True)
    for workspace in workspaces:
        kind, label = summarize(workspace)
        if kind == "busy":
            # Advances once per poll, like the start/stop spinners do per line.
            icon = f"[cyan]{SPINNER_FRAMES[tick % len(SPINNER_FRAMES)]}"
        else:
            icon = STATUS_ICONS[kind]
        used = parse_time(workspace["last_used_at"])
        table.add_row(
            f"{icon} [bold]{workspace['name']}",
            Text.assemble(
                (label, STATUS_STYLES[kind]),
                ("  outdated" if workspace["outdated"] else "", "yellow"),
                ("  ⇄ forwarded" if workspace["name"] == forwarded else "", "blue"),
            ),
            Text(schedule(workspace, now), style="dim"),
            Text(f"used {duration(now - used)} ago" if used else "", style="dim"),
        )
    return table


def show_status(excludes: list[str]) -> int:
    def fetch() -> list[dict]:
        workspaces = list_workspaces()
        shown = [w for w in workspaces if not is_excluded(w["name"], excludes)]
        return sorted(shown, key=lambda w: w["name"])

    def busy(workspaces: list[dict]) -> bool:
        return any(summarize(w)[0] == "busy" for w in workspaces)

    workspaces, tick = fetch(), 0
    forward = Forward.load()
    forwarded = forward.workspace if forward and forward.running else None
    if not workspaces:
        console.print("No workspaces.")
        return 0

    # Keep polling only while something is changing state, so a quick check
    # returns right away. Ctrl-C stops watching and keeps the last snapshot.
    with Live(
        render_status(workspaces, tick, forwarded),
        console=console,
        transient=True,
        auto_refresh=False,
    ) as live:
        try:
            while busy(workspaces):
                time.sleep(POLL_SECONDS)
                workspaces, tick = fetch(), tick + 1
                live.update(render_status(workspaces, tick, forwarded), refresh=True)
        except KeyboardInterrupt:
            pass
    console.print(render_status(workspaces, tick, forwarded))
    return 0


def choose(excludes: list[str], selected: list[str] | None) -> list[dict]:
    """The workspaces named by -w (even excluded ones), else all non-excluded ones.

    Exits if -w names a workspace that doesn't exist.
    """
    workspaces = list_workspaces()
    if selected is None:
        return [w for w in workspaces if not is_excluded(w["name"], excludes)]
    names = {w["name"] for w in workspaces}
    if unknown := [name for name in selected if name not in names]:
        console.print(f"[red]✗[/] No workspace named {escape(', '.join(unknown))}.")
        sys.exit(2)
    return [w for w in workspaces if w["name"] in selected]


def workspace_list(value: str) -> list[str]:
    """Parse one -w value: comma-separated workspace names."""
    names = [name.strip() for name in value.split(",") if name.strip()]
    if not names:
        raise argparse.ArgumentTypeError("expected workspace names")
    return names


def change(
    action: str, excludes: list[str], dry_run: bool, selected: list[str] | None
) -> int:
    """Run `coder start` or `coder stop` on every workspace that needs it."""
    targets = []
    for workspace in choose(excludes, selected):
        name = workspace["name"]
        if not needs_action(workspace, action):
            status = workspace["latest_build"]["status"]
            console.print(f"[dim]  - {name}: already {status}")
        else:
            targets.append(name)

    if not targets:
        console.print(f"Nothing to {action}.")
        return 0
    if dry_run:
        console.print(f"Would {action}: {', '.join(targets)}")
        return 0

    if action == "stop":
        # Its ports would go dead anyway.
        stop_forward(only=set(targets))
    jobs = [Job(name, steps(action, name), DONE[action]) for name in targets]
    return run_jobs(jobs, action)


def restart(
    excludes: list[str], dry_run: bool, update: bool, selected: list[str] | None
) -> int:
    """Restart every running workspace, updating any that are out of date.

    `coder update` stops and starts an outdated workspace on the template's
    latest version; the rest get `coder restart`.
    """
    targets: dict[str, bool] = {}  # Workspace name: whether to update it.
    for workspace in choose(excludes, selected):
        name, build = workspace["name"], workspace["latest_build"]
        # Running, or failed to start (where restarting is a retry).
        if build["transition"] == "start" and build["status"] in ("running", "failed"):
            targets[name] = update and workspace["outdated"]
        else:
            console.print(f"[dim]  - {name}: {summarize(workspace)[1]}")

    if not targets:
        console.print("Nothing to restart.")
        return 0
    updating = [name for name, outdated in targets.items() if outdated]
    restarting = [name for name, outdated in targets.items() if not outdated]
    if dry_run:
        if updating:
            console.print(f"Would update: {', '.join(updating)}")
        if restarting:
            console.print(f"Would restart: {', '.join(restarting)}")
        return 0

    jobs = []
    for name, outdated in targets.items():
        if outdated:
            # No --yes here; this keeps it from prompting for new parameters.
            first = ("Updating", ["coder", "update", "--use-parameter-defaults", name])
        else:
            first = ("Restarting", ["coder", "restart", "--yes", name])
        done = "updated" if outdated else "restarted"
        jobs.append(Job(name, [first, steps("start", name)[-1]], done))

    # Its connection would drop, so stop it now and start it again after.
    forward = stop_forward(only=set(targets))
    code = run_jobs(jobs, "restart")
    if forward and any(
        j.name == forward.workspace and j.state != "failed" for j in jobs
    ):
        code = start_forward(forward.workspace, forward.args, excludes) or code
    elif forward:
        console.print(
            f"[dim]Not restarting the forward from {forward.description}; "
            "`codo forward restart` will once it's up."
        )
    return code


def make_log_dir() -> Path:
    """A new private (mode 700) directory for command output."""
    return Path(tempfile.mkdtemp(prefix=time.strftime("codo-%Y%m%d-%H%M%S-")))


def save_log(name: str, text: str) -> Path:
    """Save one command's full output in a new log directory."""
    path = make_log_dir() / f"{name}.log"
    path.write_text(text)
    return path


def print_tail(lines: list[str], log: Path) -> None:
    """Print the end of a failed command's output; `log` has all of it."""
    lines = [line for line in lines if not CODER_EXIT_NOISE.match(line)]
    if len(lines) > OUTPUT_LINES:
        omitted = len(lines) - OUTPUT_LINES
        # soft_wrap so a long path isn't broken across lines when copied.
        path = escape(str(log))
        console.print(f"[dim]… {omitted} earlier lines in {path}", soft_wrap=True)
        lines = lines[-OUTPUT_LINES:]
    console.print("\n".join(lines), markup=False, highlight=False, soft_wrap=True)


def run_jobs(jobs: list[Job], what: str) -> int:
    """Run jobs in parallel behind a live table, then show output of failures.

    Every job's full output is saved in a new log directory, as it arrives.
    """
    logs = make_log_dir()
    for job in jobs:
        job.log = logs / f"{job.name}.log"
    console.print(f"[dim]Logs: {escape(str(logs))}", soft_wrap=True)

    # The live view is transient so the final table is printed exactly once,
    # whether or not stdout is a terminal.
    with Live(get_renderable=lambda: render(jobs), console=console, transient=True):
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(jobs)) as pool:
            futures = [pool.submit(job.run) for job in jobs]
            for future in concurrent.futures.as_completed(futures):
                future.result()
    console.print(render(jobs))

    for job in jobs:
        if job.state in ("failed", "warning"):
            console.rule(f"{job.name}: {job.phase}", style=STYLES[job.state])
            assert job.log is not None
            print_tail(job.output, job.log)

    failed = sum(job.state == "failed" for job in jobs)
    if failed:
        console.print(
            f"[red]{failed} of {len(jobs)} workspaces failed to {escape(what)}."
        )
        return 1
    return 0


def pick_active(excludes: list[str]) -> list[dict]:
    """Running, non-excluded workspaces. Says why any non-running one is skipped."""
    active = []
    for workspace in list_workspaces():
        name = workspace["name"]
        if is_excluded(name, excludes):
            continue
        if not is_active(workspace):
            console.print(f"[dim]  - {name}: {summarize(workspace)[1]}")
        else:
            active.append(workspace)
    return active


# A step run in the repo: (label for the table, what to show, sh snippet).
class RepoStep(NamedTuple):
    label: str
    detail: str
    command: str


def repo_command(label: str, command: list[str]) -> RepoStep:
    return RepoStep(label, shlex.join(command), f"exec {shlex.join(command)}")


# `codo fetch`, which also fast-forwards main when it's checked out and behind
# (and nothing else). If local changes would be overwritten, git refuses and
# the step fails.
FETCH: RepoStep = RepoStep(
    "fetching",
    "git fetch origin main (fast-forwarding main)",
    "git fetch origin main"
    ' && if [ "$(git symbolic-ref --short -q HEAD)" = main ]'
    " && git merge-base --is-ancestor HEAD FETCH_HEAD;"
    " then git merge --ff-only FETCH_HEAD; fi",
)
FRESHEN = [
    FETCH,
    repo_command(
        "starting services", ["clyde", "start", "-i", "discord_pytest_daemon", "admin"]
    ),
    repo_command("stopping services", ["clyde", "stop"]),
]


def repo_script(snippet: str, repos: list[str]) -> str:
    """An sh script that runs `snippet` in the first of `repos` that exists.

    Workspaces lay the repo out differently, hence the list.
    """
    dirs = " ".join(shlex.quote(repo) for repo in repos)
    # stdin from /dev/null: coder ssh's pty never sends EOF, so anything that
    # prompts (like clyde offering to file a helpdesk report) would hang forever.
    return (
        f"exec < /dev/null; for dir in {dirs}; do "
        f'if [ -e "$dir/.git" ]; then cd "$dir" || exit; {snippet}; exit; fi; '
        f"done; echo codo: no repo at {dirs}; exit 1"
    )


def run_in_repo(plan: list[RepoStep], repos: list[str], excludes: list[str]) -> int:
    """Run commands in the discord repo on every running, non-excluded workspace.

    Each workspace runs the steps of `plan` in order, stopping at the first
    failure.
    """
    scripts = [(label, repo_script(snippet, repos)) for label, _, snippet in plan]
    if any("\\" in script for _, script in scripts):
        console.print("[red]✗[/] codo can't pass backslashes through to workspaces.")
        return 2
    targets = [workspace["name"] for workspace in pick_active(excludes)]
    if not targets:
        console.print("No running workspaces.")
        return 1

    shown = " && ".join(text for _, text, _ in plan)
    console.print(
        f"Running [bold]{escape(shown)}[/] in the repo on {', '.join(targets)}."
    )
    jobs = [
        Job(name, [(label, sh_command(name, s)) for label, s in scripts], "done")
        for name in targets
    ]
    return run_jobs(jobs, f"run {shown}")


def browser_login(bootstrap_url: str) -> str | None:
    """Do gcloud's browser step locally; returns the line to paste back."""
    # gcloud asks us to confirm the bootstrap URL came from a machine we trust.
    # We read it straight from our own workspace, so answer yes.
    proc = subprocess.run(
        ["gcloud", "auth", "login", f"--remote-bootstrap={bootstrap_url}"],
        input="y\n",
        capture_output=True,
        text=True,
    )
    if match := AUTH_RESPONSE.search(proc.stderr):
        return match[0]
    output = (proc.stdout + proc.stderr).strip()
    console.print("[red]✗[/] The browser login didn't complete:")
    print_tail(output.splitlines(), save_log("browser-login", output))
    return None


def login(workspace: str) -> int:
    """Refresh gcloud and application default credentials on one workspace.

    `gcloud auth login --no-browser` on the workspace prints a command to run
    on a machine with a browser, then waits for that command's output. We run
    it here and type its output back in.
    """
    console.print(f"[dim]Connecting to {workspace}…")
    # coder ssh always gives the remote command a pty, so gcloud prompts as if
    # interactive and reads our answers from stdin.
    remote = subprocess.Popen(
        ["coder", "ssh", workspace, "--"]
        + ["gcloud", "auth", "login", "--update-adc", "--no-browser"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    assert remote.stdin is not None and remote.stdout is not None

    def send(line: str) -> None:
        remote.stdin.write(line.encode() + b"\n")
        remote.stdin.flush()

    raw, transcript = b"", ""
    stages = answered = 0
    responded = False
    try:
        while chunk := os.read(remote.stdout.fileno(), 65536):
            raw += chunk
            transcript = ANSI_ESCAPE.sub("", raw.decode(errors="replace"))
            transcript = transcript.replace("\r", "")
            # Progress from coder ssh, e.g. if it has to start the workspace.
            for stage in STAGE_LINE.findall(transcript)[stages:]:
                console.print(f"[dim]  {stage}…")
                stages += 1
            while transcript.count(YES_NO_PROMPT) > answered:
                send("Y")
                answered += 1
            if not responded and AUTH_PROMPT in transcript:
                responded = True
                if not (match := REMOTE_BOOTSTRAP.search(transcript)):
                    remote.kill()  # Nothing to answer it with; report below.
                    break
                console.print("[dim]Finish signing in in your browser…")
                if (response := browser_login(match["url"])) is None:
                    return 1
                send(response)
        remote.wait()
    finally:
        # The pty never passes EOF through, so an abandoned session would hang.
        if remote.poll() is None:
            remote.kill()
            remote.wait()

    match = LOGGED_IN.search(transcript)
    if remote.returncode == 0 and match:
        console.print(f"[green]✓[/] {workspace}: logged in as [bold]{match['account']}")
        return 0
    reason = f"exit code {remote.returncode}" if remote.returncode else "not logged in"
    console.print(f"[red]✗[/] gcloud login on {workspace} failed ({reason}):")
    log = save_log(f"{workspace}-login", transcript)
    print_tail(transcript.strip().splitlines(), log)
    return 1


def sh_command(workspace: str, script: str) -> list[str]:
    """The `coder ssh` command line to run a POSIX sh script on a workspace.

    coder ssh joins its arguments with spaces for the workspace's login shell
    (fish), so pass one pre-quoted `sh -c` command. fish treats backslashes in
    single quotes differently from sh, so scripts must not contain any.
    """
    assert "\\" not in script
    return ["coder", "ssh", workspace, "--", shlex.join(["sh", "-c", script])]


def remote_sh(
    workspace: str, script: str, env: dict[str, str] | None = None
) -> subprocess.CompletedProcess:
    """Run a POSIX sh script on a workspace, with `env` set in its environment."""
    # Passing env through CODER_SSH_ENV keeps values (like credentials) out of
    # process arguments, and out of stdin, which coder echoes through a pty.
    ssh_env = ",".join(f"{key}={value}" for key, value in (env or {}).items())
    return subprocess.run(
        sh_command(workspace, script),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        env={**os.environ, "CODER_SSH_ENV": ssh_env} if env else None,
    )


def failure(proc: subprocess.CompletedProcess) -> str:
    """A short reason a remote command failed: its last line of output.

    The remote command's own output arrives on stdout (through the pty), so
    prefer it over coder's generic "Process exited with status N" on stderr.
    """
    for stream in (proc.stdout, proc.stderr):
        if lines := stream.strip().splitlines():
            return lines[-1].strip()
    return f"exit code {proc.returncode}"


def read_adc(workspace: str) -> str | None:
    """The workspace's ADC file, base64-encoded, if it looks valid."""
    proc = remote_sh(workspace, READ_ADC)
    if not (match := ADC_LINE.search(proc.stdout)):
        reason = escape(failure(proc))
        console.print(f"[red]✗[/] Couldn't read ADC from {workspace}: {reason}")
        return None
    # Never print the output from here on: it contains the credentials.
    try:
        adc = json.loads(base64.b64decode(match["adc"]))
    except ValueError:
        adc = None
    if not (isinstance(adc, dict) and adc.get("refresh_token")):
        console.print(f"[red]✗[/] The ADC file on {workspace} has no refresh token.")
        return None
    return match["adc"]


def write_adc(workspace: str, adc: str) -> str | None:
    """Install base64-encoded ADC on a workspace; returns an error, if any."""
    proc = remote_sh(workspace, WRITE_ADC, {"CODO_ADC": adc})
    return None if proc.returncode == 0 and "CODO_OK" in proc.stdout else failure(proc)


def login_everywhere(excludes: list[str]) -> int:
    """Log in on one running workspace, then copy its ADC to the others."""
    active = pick_active(excludes)
    if not active:
        console.print("No running workspaces to log in to.")
        return 1
    # Any would do; the most recently used is likely the one you're in.
    never = datetime.min.replace(tzinfo=timezone.utc)
    source = max(active, key=lambda w: parse_time(w["last_used_at"]) or never)
    targets = sorted(w["name"] for w in active if w["name"] != source["name"])

    plan = f"Logging in on [bold]{source['name']}[/] (most recently used)"
    if targets:
        plan += f", then copying its ADC to {', '.join(targets)}"
    console.print(plan + ".")
    if code := login(source["name"]):
        return code
    if not targets:
        return 0
    if (adc := read_adc(source["name"])) is None:
        return 1

    failed = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(targets)) as pool:
        futures = {pool.submit(write_adc, name, adc): name for name in targets}
        for future in concurrent.futures.as_completed(futures):
            name = futures[future]
            if error := future.result():
                failed += 1
                console.print(f"[red]✗[/] {name}: {escape(error)}")
            else:
                console.print(f"[green]✓[/] {name}: ADC copied")
    return 1 if failed else 0


@dc.dataclass
class Forward:
    """The background `clyde coder forward start`, as saved in FORWARD_STATE.

    The process leads its own process group (clyde runs coder under a shell),
    so pid is also the group to signal. It's None once stopped; the workspace
    and args are kept for `codo forward restart`.
    """

    workspace: str
    args: list[str]
    pid: int | None = None
    started: float | None = None  # Unix time.

    @classmethod
    def load(cls) -> "Forward | None":
        try:
            return cls(**json.loads(FORWARD_STATE.read_text()))
        except FileNotFoundError:
            return None

    def save(self) -> None:
        FORWARD_STATE.write_text(json.dumps(dc.asdict(self)))

    @property
    def running(self) -> bool:
        """Whether our forward is still alive (and pid hasn't been reused)."""
        if self.pid is None:
            return False
        proc = subprocess.run(
            ["ps", "-o", "pgid=,command=", "-p", str(self.pid)],
            capture_output=True,
            text=True,
        )
        pgid, _, command = proc.stdout.strip().partition(" ")
        return pgid == str(self.pid) and "coder forward" in command

    @property
    def description(self) -> str:
        args = f" ({shlex.join(self.args)})" if self.args else ""
        return f"[bold]{escape(self.workspace)}[/]{escape(args)}"

    def stop(self) -> None:
        """Stop the forward and wait for it, so its ports are free again."""
        if self.running:
            assert self.pid is not None
            for sig, wait in (
                (signal.SIGTERM, FORWARD_STOP_SECONDS),
                (signal.SIGKILL, 2),
            ):
                try:
                    os.killpg(self.pid, sig)
                except ProcessLookupError:
                    break
                deadline = time.monotonic() + wait
                while time.monotonic() < deadline and group_alive(self.pid):
                    time.sleep(0.1)
                if not group_alive(self.pid):
                    break
        self.pid = self.started = None
        self.save()


def group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass  # Exists, though not ours to signal.
    return True


def forward_tail(lines: int = OUTPUT_LINES) -> None:
    if FORWARD_LOG.exists():
        output = ANSI_ESCAPE.sub("", FORWARD_LOG.read_text(errors="replace"))
        print_tail(output.strip().splitlines()[-lines:], FORWARD_LOG)


def forward_status() -> int:
    forward = Forward.load()
    if forward and forward.running:
        assert forward.started is not None
        up = duration(timedelta(seconds=time.time() - forward.started))
        console.print(
            f"[green]●[/] Forwarding ports from {forward.description}"
            f" [dim](pid {forward.pid}, up {up})"
        )
        console.print(f"[dim]Log: {escape(str(FORWARD_LOG))}", soft_wrap=True)
        return 0
    if forward and forward.pid is not None:
        console.print(f"[red]✗[/] The forward from {forward.description} exited:")
        forward_tail()
        console.print("[dim]Run `codo forward restart` to start it again.")
        return 1
    last = f" [dim](last: {forward.description})" if forward else ""
    console.print(f"[dim]○[/] Not forwarding{last}")
    return 0


def stop_forward(only: set[str] | None = None) -> "Forward | None":
    """Stop the forward, if there is one (and it's from a workspace in `only`).

    Returns the forward it stopped, if any.
    """
    forward = Forward.load()
    if not (forward and forward.running):
        return None
    if only is not None and forward.workspace not in only:
        return None
    console.print(f"[dim]Stopping the forward from {forward.description}…")
    stopped = dc.replace(forward)
    forward.stop()
    return stopped


class Waiting:
    """A one-row live view for a slow sequence: a spinner, phase and elapsed time.

    Unlike the start/stop spinners, this one spins on a timer: what it waits
    on (coder's version check, clyde setting up) is often silent for a while.
    """

    def __init__(self) -> None:
        self.phase = ""
        self.began = time.monotonic()
        self.spinner = Spinner("dots", style="cyan")

    def __rich__(self) -> Table:
        seconds = int(time.monotonic() - self.began)
        table = Table.grid(padding=(0, 1))
        table.add_row(
            self.spinner,
            Text(self.phase + "…"),
            Text(f"{seconds // 60}:{seconds % 60:02d}", style="dim"),
        )
        return table


def forward_phase(output: str, workspace: str) -> str:
    """What the forward is up to, judging by its output so far."""
    if ports := len(FORWARD_PORT.findall(output)):
        return f"Forwarding {ports} ports from {workspace}"
    if "Starting connections" in output:
        return f"Connecting to {workspace}"
    return "Starting clyde"


def start_forward(workspace: str | None, args: list[str], excludes: list[str]) -> int:
    """Forward ports from `workspace` in the background, replacing any forward.

    With no workspace, use the last one forwarded, else the most recently used
    running one.
    """
    waiting = Waiting()
    with Live(waiting, console=console, transient=True, refresh_per_second=12.5):
        return _start_forward(waiting, workspace, args, excludes)


def _start_forward(
    waiting: Waiting, workspace: str | None, args: list[str], excludes: list[str]
) -> int:
    waiting.phase = "Checking workspaces"
    previous = Forward.load()
    workspaces = {w["name"]: w for w in list_workspaces()}
    if workspace is None and previous:
        workspace = previous.workspace
    if workspace is None:
        never = datetime.min.replace(tzinfo=timezone.utc)
        active = [
            w
            for w in workspaces.values()
            if is_active(w) and not is_excluded(w["name"], excludes)
        ]
        if not active:
            console.print("No running workspaces to forward from.")
            return 1
        workspace = max(active, key=lambda w: parse_time(w["last_used_at"]) or never)[
            "name"
        ]
    if workspace not in workspaces:
        console.print(f"[red]✗[/] No workspace named {escape(workspace)}.")
        return 1

    if previous and previous.running:
        if previous.workspace == workspace and previous.args == args:
            console.print(f"Already forwarding ports from {previous.description}.")
            return 0
        waiting.phase = f"Stopping the forward from {previous.workspace}"
        previous.stop()
        console.print(f"[dim]Stopped the forward from {previous.description}.")

    forward = Forward(workspace, args)
    if not is_active(workspaces[workspace]):
        label = summarize(workspaces[workspace])[1]
        console.print(f"[dim]{escape(workspace)} is {label}; coder will start it.")
    waiting.phase = "Starting clyde"
    FORWARD_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with FORWARD_LOG.open("wb") as log:
        # A new session, so it outlives this process and the terminal, and so
        # stop() can signal clyde and the coder process it runs together.
        try:
            proc = subprocess.Popen(
                ["clyde", "coder", "forward", "start", "-w", workspace, *args],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        except FileNotFoundError:
            console.print("[red]✗[/] clyde isn't on PATH.")
            return 1
    forward.pid, forward.started = proc.pid, time.time()
    # Saved before waiting, so Ctrl-C leaves it running and manageable.
    forward.save()

    # Wait for coder to say it's ready.
    deadline = time.monotonic() + FORWARD_READY_SECONDS
    ready = False
    while proc.poll() is None and time.monotonic() < deadline:
        output = FORWARD_LOG.read_text(errors="replace")
        if ready := bool(FORWARD_READY.search(output)):
            break
        waiting.phase = forward_phase(output, workspace)
        time.sleep(0.2)

    if proc.poll() is not None:
        console.print(
            f"[red]✗[/] The forward from {forward.description} exited "
            f"(exit code {proc.returncode}):"
        )
        forward_tail()
        return 1
    if not ready:
        console.print(
            f"[yellow]⚠[/] Still connecting to {forward.description} in the "
            "background; check on it with `codo forward`."
        )
        return 0
    took = int(time.monotonic() - waiting.began)
    console.print(
        f"[green]✓[/] Forwarding ports from {forward.description} in the "
        f"background [dim](pid {proc.pid}, ready in {took}s)"
    )
    return 0


FORWARD_USAGE = """\
usage: codo forward [WORKSPACE] [CLYDE_ARGS...]
       codo forward {status,stop,restart,log [-f]}

Run `clyde coder forward start` in the background, replacing any forward
already running (so `codo forward other-workspace` switches workspaces).
Without a workspace, use the last one forwarded, else the most recently used
running one. CLYDE_ARGS (like --no-web or -t 1234) go to clyde.

  status   show what's being forwarded (the default)
  stop     stop forwarding
  restart  stop, then start the last forward again
  log      show the end of the forward's output (-f: follow it)
"""


def forward(argv: list[str], excludes: list[str]) -> int:
    """`codo forward ...`, parsed by hand so clyde's flags pass through."""
    match argv:
        case [] | ["status"]:
            return forward_status()
        case ["-h" | "--help" | "help"]:
            console.print(FORWARD_USAGE, markup=False, highlight=False, end="")
            return 0
        case ["stop"]:
            if not ((forward := Forward.load()) and forward.running):
                console.print("Not forwarding.")
                return 0
            forward.stop()
            console.print(f"[green]✓[/] Stopped forwarding from {forward.description}")
            return 0
        case ["restart"]:
            if not (forward := Forward.load()):
                console.print("Nothing to restart: no workspace forwarded yet.")
                return 1
            stop_forward()
            return start_forward(forward.workspace, forward.args, excludes)
        case ["log"]:
            forward_tail(lines=sys.maxsize)
            return 0
        case ["log", "-f"]:
            os.execvp("tail", ["tail", "-n", str(OUTPUT_LINES), "-F", str(FORWARD_LOG)])
        case ["start", *rest] | rest:
            # The workspace is optional, but comes before any clyde flags.
            if rest and not rest[0].startswith("-"):
                return start_forward(rest[0], rest[1:], excludes)
            return start_forward(None, rest, excludes)


# `codo tunnel`: clyde's Cloudflare dev tunnel on a workspace. These run under
# sh in the repo there (see repo_script), so they avoid backslashes.
TUNNEL_STATE = '"$HOME/.cache/codo"'
# clyde's process once its launcher has set up (`python -m discord_clyde ...`).
# The bracket keeps pgrep from matching the script that runs it.
TUNNEL_PGREP = 'pgrep -f -- "-m discord_clyd[e] tunnels run"'
# Seconds to wait for cloudflared to connect, after which it's left to it.
TUNNEL_CONNECT_SECONDS = 120
# setsid puts it in its own session, so it outlives the ssh connection and
# can be stopped as a group (clyde and the cloudflared it runs).
START_TUNNEL = "; ".join(
    [
        f"mkdir -p {TUNNEL_STATE}",
        f"log={TUNNEL_STATE}/tunnel.log",
        f"if {TUNNEL_PGREP} > /dev/null; then echo codo: tunnel already running; exit 0; fi",
        'nohup setsid clyde tunnels run > "$log" 2>&1 < /dev/null & pid=$!',
        "i=0",
        f"while [ $i -lt {TUNNEL_CONNECT_SECONDS} ]; do "
        'if grep -q "Registered tunnel connection" "$log"; '
        "then echo codo: tunnel connected; exit 0; fi; "
        'if ! kill -0 "$pid" 2> /dev/null; '
        'then echo codo: the tunnel exited:; cat "$log"; exit 1; fi; '
        "sleep 1; i=$((i + 1)); done",
        'echo "codo: tunnel still connecting; its log is $log on the workspace"',
    ]
)
# Signals the whole group if the tunnel leads one (as when codo started it),
# else just clyde; then waits for it to go.
STOP_TUNNEL = "; ".join(
    [
        f"pid=$({TUNNEL_PGREP} | head -n 1)",
        'if [ -z "$pid" ]; then echo codo: no tunnel running; exit 0; fi',
        'pgid=$(ps -o pgid= -p "$pid" | tr -d " ")',
        'if [ "$pgid" = "$pid" ]; then kill -s TERM -- "-$pid"; '
        'else kill -s TERM "$pid"; fi',
        "i=0",
        'while kill -0 "$pid" 2> /dev/null && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done',
        'if kill -0 "$pid" 2> /dev/null; then echo codo: the tunnel did not stop; exit 1; fi',
        "echo codo: tunnel stopped",
    ]
)
# Prints the addresses: the main one, then clyde's list (dashboard, services).
TUNNEL_URLS = (
    'echo "  main:  https://$CLOUDFLARE_TUNNEL_DOMAIN"; exec clyde tunnels list'
)
TUNNEL_URL_LINE = re.compile(
    r"^\s*(?P<name>[^:]+(?:\(:\d+\))?):\s+(?P<url>https://\S+)(?P<rest>.*)$"
)
SERVICE_SPEC = re.compile(
    r"^(?P<name>[A-Za-z0-9][A-Za-z0-9_-]*)(?::(?P<port>\d{1,5}))?$"
)


def tunnel(
    workspace: str, services: list[str], stop: bool, start: bool, repos: list[str]
) -> int:
    """Start (or stop) the dev tunnel on a workspace, with services exposed.

    Each service is a clyde service or tunnel group (like `admin`), which is
    started with `clyde start` and then exposed; or NAME:PORT, to expose
    whatever is on that port.
    """
    if stop:
        plan = [RepoStep("stopping tunnel", "stop the tunnel", STOP_TUNNEL)]
    else:
        specs = []
        for service in services:
            if not (match := SERVICE_SPEC.match(service)):
                console.print(
                    f"[red]✗[/] Not a service name or NAME:PORT: {escape(service)}"
                )
                return 2
            specs.append((match["name"], match["port"]))
        plan = []
        if start and (names := [name for name, port in specs if port is None]):
            plan.append(repo_command("starting services", ["clyde", "start", *names]))
        for name, port in specs:
            expose = ["clyde", "tunnels", "expose", name, *([port] if port else [])]
            plan.append(repo_command(f"exposing {name}", expose))
        plan.append(RepoStep("starting tunnel", "clyde tunnels run", START_TUNNEL))
        plan.append(RepoStep("listing addresses", "clyde tunnels list", TUNNEL_URLS))

    scripts = [(label, repo_script(snippet, repos)) for label, _, snippet in plan]
    job = Job(
        workspace, [(label, sh_command(workspace, s)) for label, s in scripts], "done"
    )
    if code := run_jobs([job], "stop the tunnel" if stop else "start the tunnel"):
        return code
    # Addresses come from the last step, which starts with the main one;
    # `clyde tunnels expose` prints some too, which would repeat them.
    starts = [i for i, line in enumerate(job.output) if line.startswith("  main:")]
    for i, line in enumerate(job.output):
        if line.startswith("codo: ") and "connected" not in line:
            console.print(f"[dim]{escape(line.removeprefix('codo: '))}")
        elif starts and i >= starts[-1] and (match := TUNNEL_URL_LINE.match(line)):
            console.print(
                f"  {escape(match['name'].strip())}: "
                f"[link={match['url']}]{escape(match['url'])}[/link]"
                f"[dim]{escape(match['rest'])}"
            )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    # Shared by start, stop and restart.
    selection = argparse.ArgumentParser(add_help=False)
    selection.add_argument(
        "-w",
        "--workspace",
        dest="workspaces",
        metavar="NAMES",
        type=workspace_list,
        action="append",
        help="act on just these workspaces (comma-separated, or repeat -w), "
        "even if excluded",
    )
    selection.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="show which workspaces would change, without changing them",
    )
    for action in DONE:
        commands.add_parser(
            action, parents=[selection], help=f"{action} all non-excluded workspaces"
        )
    sub = commands.add_parser(
        "restart",
        parents=[selection],
        help="restart all running, non-excluded workspaces, updating any that "
        "are out of date",
    )
    sub.add_argument(
        "--no-update",
        dest="update",
        action="store_false",
        help="restart outdated workspaces on their current version",
    )
    commands.add_parser("status", help="show the status of non-excluded workspaces")
    sub = commands.add_parser(
        "login",
        help="refresh gcloud credentials on workspaces using this machine's browser",
    )
    sub.add_argument(
        "workspace",
        nargs="?",
        help="log in on just this workspace. By default, log in on the most "
        "recently used running workspace and copy its ADC to the other "
        "running, non-excluded ones",
    )
    commands.add_parser(
        "fetch",
        help="run `git fetch origin main` in the repo on each workspace, "
        "fast-forwarding main if it's checked out",
    )
    commands.add_parser(
        "clyde", help="run `clyde ARGS...` in the repo on each workspace"
    )
    commands.add_parser(
        "forward",
        help="forward ports from a workspace in the background "
        "(see `codo forward --help`)",
    )
    sub = commands.add_parser(
        "tunnel",
        aliases=["tun"],
        help="start the Cloudflare dev tunnel (*.devtun.to) on a workspace, "
        "with services started and exposed",
    )
    sub.add_argument("workspace")
    sub.add_argument(
        "services",
        nargs="*",
        metavar="SERVICE",
        help="a clyde service or tunnel group (e.g. admin, discord_api) to "
        "start and expose, or NAME:PORT to expose a port as NAME",
    )
    sub.add_argument(
        "--no-start",
        dest="start",
        action="store_false",
        help="expose services without running `clyde start` for them",
    )
    sub.add_argument("--stop", action="store_true", help="stop the tunnel")
    commands.add_parser(
        "mfa",
        help="print an MFA code for logging in on local dev "
        "(`clyde app mfa --no-clipboard`, run here; extra args go to clyde)",
    )
    commands.add_parser(
        "freshen",
        help="fetch, then start and stop the pytest daemon and admin services, "
        "on each workspace",
    )

    argv = sys.argv[1:]
    config = load_config(CONFIG_PATH)
    excludes = list(config.get("exclude", []))
    repos = list(config.get("repos", [DEFAULT_REPO]))
    # Pass everything after `clyde` through untouched: argparse would otherwise
    # claim flags like `-i` or `--help` that are meant for clyde.
    if argv[:1] == ["clyde"]:
        if len(argv) == 1:
            parser.error("codo clyde needs a clyde command, e.g. `codo clyde start`")
        return run_in_repo([repo_command("running", argv)], repos, excludes)
    if argv[:1] == ["mfa"]:
        # Run here, not on a workspace: the code only depends on the secret
        # and the time. Extra args (like --secret) pass through to clyde.
        command = ["clyde", "app", "mfa", "--no-clipboard", *argv[1:]]
        try:
            os.execvp(command[0], command)
        except FileNotFoundError:
            console.print("[red]✗[/] clyde isn't on PATH.")
            return 1
    if argv[:1] == ["forward"]:
        return forward(argv[1:], excludes)
    args = parser.parse_args(argv)

    if args.command == "login":
        if args.workspace:
            return login(args.workspace)
        return login_everywhere(excludes)
    if args.command == "fetch":
        return run_in_repo([FETCH], repos, excludes)
    if args.command in ("tunnel", "tun"):
        return tunnel(args.workspace, args.services, args.stop, args.start, repos)
    if args.command == "freshen":
        return run_in_repo(FRESHEN, repos, excludes)
    if args.command == "status":
        return show_status(excludes)
    # -w values, each a list of names, flattened in order without repeats.
    selected = None
    if getattr(args, "workspaces", None):
        selected = list(dict.fromkeys(n for names in args.workspaces for n in names))
    if args.command == "restart":
        return restart(excludes, args.dry_run, args.update, selected)
    return change(args.command, excludes, args.dry_run, selected)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
